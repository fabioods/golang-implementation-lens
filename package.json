{
  "name": "golang-implementation-lens",
  "displayName": "Golang Implementation Lens",
  "description": "Show implementation count above Go interfaces with one-click navigation, similar to VS Code's native implementation lens",
  "version": "1.3.0",
  "publisher": "fabioods",
  "author": {
    "name": "Fabio Santos"
  },
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "go",
    "golang",
    "interface",
    "implementation",
    "codelens",
    "navigation",
    "go to implementation"
  ],
  "activationEvents": [
    "onLanguage:go"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "golang-implementation-lens.showImplementations",
        "title": "Go: Show Implementations",
        "category": "Go"
      },
      {
        "command": "golang-implementation-lens.showMethodImplementations",
        "title": "Go: Show Method Implementations",
        "category": "Go"
      },
      {
        "command": "golang-implementation-lens.gotoInterface",
        "title": "Go: Goto Interface",
        "category": "Go"
      },
      {
        "command": "golang-implementation-lens.clearCache",
        "title": "Go: Clear Implementation Lens Cache",
        "category": "Go"
      }
    ],
    "configuration": {
      "title": "Golang Implementation Lens",
      "properties": {
        "golangImplementationLens.excludedFolders": {
          "type": "array",
          "default": [
            "mocks",
            "mock",
            "testdata",
            "vendor"
          ],
          "items": {
            "type": "string"
          },
          "description": "List of folder names to exclude when searching for implementations. These folders will be ignored during the search process."
        },
        "golangImplementationLens.excludedFilePatterns": {
          "type": "array",
          "default": [
            "_mock.go",
            "mock_",
            ".pb.go",
            "_test.go"
          ],
          "items": {
            "type": "string"
          },
          "description": "List of file name patterns to exclude when searching for implementations. Use these patterns to filter out generated files, mocks, or test files."
        },
        "golangImplementationLens.excludedTypePatterns": {
          "type": "array",
          "default": [
            "Mock",
            "mock",
            "Stub",
            "Fake"
          ],
          "items": {
            "type": "string"
          },
          "description": "List of type name patterns to exclude from results. Types containing these strings will be filtered out."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fabioods/golang-implementation-lens.git"
  },
  "bugs": {
    "url": "https://github.com/fabioods/golang-implementation-lens/issues"
  },
  "homepage": "https://github.com/fabioods/golang-implementation-lens#readme",
  "qna": "marketplace",
  "badges": [
    {
      "url": "https://img.shields.io/badge/go-supported-blue.svg",
      "href": "https://golang.org/",
      "description": "Go Language Support"
    }
  ],
  "galleryBanner": {
    "color": "#00ADD8",
    "theme": "dark"
  }
}

